# --- AGRIFARM ENVIRONMENT CONFIGURATION ---

# 1. Access Security Hashing Secret Key (Required)
# Generate a strong random key locally (e.g. running 'openssl rand -hex 32')
SECRET_KEY=your_strong_random_secret_key_here
ALGORITHM=HS256

# 2. Database Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/farm_management
# MongoDB Atlas Cloud: mongodb+srv://your_user:your_password@cluster0.xxxxxx.mongodb.net/farm_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/farm_management

# 3. Frontend Lock URL (CORS Lock)
# This restricts which domains are allowed to hit the API server.
FRONTEND_URL=http://localhost:3030

# 4. Email Auto-Sender SMTP Config (Optional - For Password Recovery)
# Gmail SMTP Host: smtp.gmail.com, Port: 587 (TLS) or 465 (SSL)
# Note: Google accounts require generating an 'App Password', not your standard login password!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_SENDER=AgriFarm Command <your_gmail_address@gmail.com>
